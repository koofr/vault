  },
  "web.landing_page_desktop.description": {
    "defaultMessage": "Koofr Vault je odprtokodna aplikacija za shranjevanje na strani odjemalca, šifrirana z ničelnim znanjem za oblačno shrambo Koofr. Nadgradi varnost svojih datotek. Odkrij boljši način za varno shranjevanje in dostop do svojih fotografij, videoposnetkov in dokumentov."
  },
  "web.landing_page_unofficial.warning": {
