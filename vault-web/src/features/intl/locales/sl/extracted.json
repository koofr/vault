  "web.intro.step_1.content": {
    "defaultMessage": "Dobrodošel v Koofr Vault: tvoji najljubši oblačni shrambi s šifriranjem na strani odjemalca!"
  },
  "web.intro.step_1.title": {
    "defaultMessage": "Dobrodošel"
  },
  "web.intro.step_2.content_1": {
    "defaultMessage": "Vault je kot škatla z edinstveno ključavnico v prtljažniku: dodatna plast varnosti za zaščito tvojih najbolj občutljivih datotek."
  },
  "web.intro.step_2.content_2": {
    "defaultMessage": "Vault je <a>odprtokodna</a> programska oprema, zato lahko vedno preveriš, ali koda počne točno to, kar je obljubljeno - in nič več."
  },
  "web.intro.step_2.content_3": {
    "defaultMessage": "Združljivost z <a>rclone</a>: šifrirane datoteke lahko preneseš in jih lokalno dešifriraš z orodjem ukazne vrstice rclone."
  },
  "web.intro.step_2.title": {
    "defaultMessage": "O Vaultu"
  },
  "web.intro.step_3.content_1": {
    "defaultMessage": "V svojem Vaultu imaš lahko enega ali več sefov, z ločenimi ključi za vsak sef."
  },
  "web.intro.step_3.content_2": {
    "defaultMessage": "Vault šifrira tako imena datotek kot tudi vsebino, zato je vse berljivo le znotraj sefa."
  },
  "web.intro.step_3.content_3": {
    "defaultMessage": "V tvoji aplikaciji Koofr bodo datoteke prikazane s šifriranimi imeni in jih ne bo mogoče odpreti."
  },
  "web.intro.step_3.title": {
    "defaultMessage": "Sefi"
  },
  "web.intro.step_4.content_1": {
    "defaultMessage": "Ko ustvariš sef, zanj izbereš ločen zasebni ključ."
  },
  "web.intro.step_4.content_2": {
    "defaultMessage": "Ker se zasebni ključ uporablja za šifriranje datotek, ki jih shraniš v sefu, ga kasneje ni mogoče spremeniti."
  },
  "web.intro.step_4.content_3": {
    "defaultMessage": "<b>Če pozabiš svoj zasebni ključ, datotek ne boš mogel obnoviti.</b> Ključ se nikoli ne pošlje na strežnike Koofr in se tam tudi ne shrani."
  },
  "web.intro.step_4.title": {
    "defaultMessage": "Zasebni ključ"
  },
  "web.intro.step_5.content": {
    "defaultMessage": "Začni uporabljati Vault tako, da ustvariš svoj prvi sef."
  },
  "web.intro.step_5.title": {
    "defaultMessage": "Začni uporabljati Vault"
  },
  "web.landing_page.copyright.text": {
    "defaultMessage": "© {year}. <a>Koofr d.o.o.</a> vse pravice pridržane."
  },
  "web.landing_page.description": {
    "defaultMessage": "Zmogljivo, odprtokodno šifriranje z ničelnim znanjem na strani odjemalca. Nadgradi varnost svojih najbolj občutljivih datotek s Koofr Vaultom."
  },
  "web.landing_page.get_started.button": {
    "defaultMessage": "Želim pričeti"
  },
  "web.landing_page.section_1.content": {
    "defaultMessage": "Koofr Vault je odprtokodna aplikacija za shranjevanje z ničelnim znanjem, ki deluje na strani odjemalca za <a>oblačno shrambo Koofr</a>. Vault je kot škatla z edinstveno ključavnico v prtljažniku: dodatna plast varnosti za zaščito tvojih datotek."
  },
  "web.landing_page.section_1.title": {
    "defaultMessage": "Izjemno močna zaščita"
  },
  "web.landing_page.section_10.description": {
    "defaultMessage": "Začni šifrirati datoteke v oblaku v samo nekaj minutah. Vključeno v vseh <a>Koofrovih paketih</a>."
  },
  "web.landing_page.section_10.questions": {
    "defaultMessage": "Imaš vprašanja o Koofr Vaultu? <a>Poišči odgovore tukaj</a>."
  },
  "web.landing_page.section_10.title": {
    "defaultMessage": "Odkleni svoj Vault"
  },
  "web.landing_page.section_2.content": {
    "defaultMessage": "Izberi zasebni ključ in ustvari sef v svojem Koofr Vaultu."
  },
  "web.landing_page.section_2.title": {
    "defaultMessage": "Zasebni ključ"
  },
  "web.landing_page.section_3.content": {
    "defaultMessage": "Datoteke v tvojem sefu so šifrirane ali dešifrirane na zahtevo, v tvoji napravi."
  },
  "web.landing_page.section_3.title": {
    "defaultMessage": "Vse ostane v tvojem brskalniku"
  },
  "web.landing_page.section_4.content": {
    "defaultMessage": "Vsebina v oblaku je šifrirana in ni nikoli dostopna brez tvojega zasebnega ključa."
  },
  "web.landing_page.section_4.title": {
    "defaultMessage": "Samo ti imaš dostop"
  },
  "web.landing_page.section_5.content_1": {
    "defaultMessage": "Tvoje datoteke so šifrirane, vključno z imeni datotek in vso vsebino, lokalno v tvoji napravi s tvojih zasebnim ključem in nekaj čarobne soli, preden so poslane v tvoj Vault."
  },
  "web.landing_page.section_5.content_2": {
    "defaultMessage": "Ne tvoj zasebni ključ, niti nobeni drugi nešifrirani podatki ali metapodatki datotek niso poslani <a>Koofru</a> ali shranjeni v njem. Samo ti lahko dešifriraš in dostopaš do svojih datotek v Vaultu."
  },
  "web.landing_page.section_5.title": {
    "defaultMessage": "Samo za tvoje oči"
  },
  "web.landing_page.section_6.content_1": {
    "defaultMessage": "Koofr Vault je <a>odprtokoden</a>, zato lahko vedno preveriš, ali koda počne točno to, kar je obljubljeno - in nič drugega. Šifriranje datotek se izvaja z uporabo NaCl SecretBox, ki uporablja šifro XSalsa20 in Poly1305 za zagotavljanje integritete."
  },
  "web.landing_page.section_6.content_2": {
    "defaultMessage": "Združljiv z orodjem <a>rclone</a>. To pomeni, da lahko preneseš šifrirane datoteke in jih lokalno dešifriraš z orodjem ukazne vrstice rclone."
  },
  "web.landing_page.section_6.title": {
    "defaultMessage": "Popolnoma odprtokoden"
  },
  "web.landing_page.section_7.title": {
    "defaultMessage": "Šifriranje na strani odjemalca"
  },
  "web.landing_page.section_8.title": {
    "defaultMessage": "Preverljiva izvorna koda"
  },
  "web.landing_page.section_9.title": {
    "defaultMessage": "Ničelno znanje"
  },
  "web.landing_page.title": {
    "defaultMessage": "En trezor za vse tvoje<br></br><b>{typing_text}</b>"
  },
  "web.landing_page.title.typing_text_1": {
