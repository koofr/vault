      "value": ". Vault je kot škatla z edinstveno ključavnico v prtljažniku: dodatna plast varnosti za zaščito tvojih datotek."
    }
  ],
  "web.landing_page.section_1.title": [
    {
      "type": 0,
      "value": "Izjemno močna zaščita"
    }
  ],
  "web.landing_page.section_10.description": [
    {
      "type": 0,
      "value": "Začni šifrirati datoteke v oblaku v samo nekaj minutah. Vključeno v vseh "
    },
    {
      "children": [
        {
          "type": 0,
          "value": "Koofrovih paketih"
        }
      ],
      "type": 8,
