      "type": 0,
      "value": "."
    }
  ],
  "web.landing_page.section_10.questions": [
    {
      "type": 0,
      "value": "Imaš vprašanja o Koofr Vaultu? "
    },
    {
      "children": [
        {
          "type": 0,
          "value": "Poišči odgovore tukaj"
        }
      ],
      "type": 8,
      "value": "a"
