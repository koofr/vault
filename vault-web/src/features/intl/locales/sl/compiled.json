  "web.repo_create.form.salt.description": [
    {
      "children": [
        {
          "type": 0,
          "value": "Sol (salt) se uporablja v procesu izpeljave ključev za ustvarjanje edinstvenega šifrirnega ključa in pomaga pri zaščiti pred morebitnimi napadi. Varno bo shranjena na Koofrovih strežnikih."
        }
      ],
      "type": 8,
      "value": "p"
    },
    {
      "children": [
        {
          "type": 0,
          "value": "Za vas je bila ustvarjena naključna sol. Če želite, lahko polje Sol pustite prazno in uporabljena bo privzeta sol (enako kot v rclone). Vendar pa je za večjo varnost priporočljivo uporabiti edinstveno sol. Uporaba edinstvene soli pomaga povečati zahtevnost postopka šifriranja, zaradi česar je morebitnim napadalcem otežen dostop do šifriranih podatkov."
        }
      ],
      "type": 8,
      "value": "p"
    },
    {
      "children": [
        {
          "type": 0,
          "value": "Če želite šifrirane datoteke prenesti v drugo storitev, je potrebno izvoziti tudi sol, sicer datotek ne boste mogli dešifrirati."
        }
      ],
      "type": 8,
      "value": "p"
    }
  ],
