  "web.landing_page.description": [
    {
      "type": 0,
      "value": "Zmogljivo, odprtokodno šifriranje z ničelnim znanjem na strani odjemalca. Nadgradi varnost svojih najbolj občutljivih datotek s Koofr Vaultom."
    }
  ],
