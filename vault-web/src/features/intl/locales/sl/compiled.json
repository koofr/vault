  "web.intro.step_1.content": [
    {
      "type": 0,
      "value": "Dobrodošel v Koofr Vault: tvoji najljubši oblačni shrambi s šifriranjem na strani odjemalca!"
    }
  ],
  "web.intro.step_1.title": [
    {
      "type": 0,
      "value": "Dobrodošel"
    }
  ],
  "web.intro.step_2.content_1": [
    {
      "type": 0,
      "value": "Vault je kot škatla z edinstveno ključavnico v prtljažniku: dodatna plast varnosti za zaščito tvojih najbolj občutljivih datotek."
    }
  ],
  "web.intro.step_2.content_2": [
    {
      "type": 0,
      "value": "Vault je "
    },
    {
      "children": [
        {
          "type": 0,
          "value": "odprtokodna"
        }
      ],
      "type": 8,
      "value": "a"
    },
    {
      "type": 0,
      "value": " programska oprema, zato lahko vedno preveriš, ali koda počne točno to, kar je obljubljeno - in nič več."
    }
  ],
  "web.intro.step_2.content_3": [
    {
      "type": 0,
      "value": "Združljivost z "
    },
    {
      "children": [
        {
          "type": 0,
          "value": "rclone"
        }
      ],
      "type": 8,
      "value": "a"
    },
    {
      "type": 0,
      "value": ": šifrirane datoteke lahko preneseš in jih lokalno dešifriraš z orodjem ukazne vrstice rclone."
    }
  ],
  "web.intro.step_2.title": [
    {
      "type": 0,
      "value": "O Vaultu"
    }
  ],
  "web.intro.step_3.content_1": [
    {
      "type": 0,
      "value": "V svojem Vaultu imaš lahko enega ali več sefov, z ločenimi ključi za vsak sef."
    }
  ],
  "web.intro.step_3.content_2": [
    {
      "type": 0,
      "value": "Vault šifrira tako imena datotek kot tudi vsebino, zato je vse berljivo le znotraj sefa."
    }
  ],
  "web.intro.step_3.content_3": [
    {
      "type": 0,
      "value": "V tvoji aplikaciji Koofr bodo datoteke prikazane s šifriranimi imeni in jih ne bo mogoče odpreti."
    }
  ],
  "web.intro.step_3.title": [
    {
      "type": 0,
      "value": "Sefi"
    }
  ],
  "web.intro.step_4.content_1": [
    {
      "type": 0,
      "value": "Ko ustvariš sef, zanj izbereš ločen zasebni ključ."
    }
  ],
  "web.intro.step_4.content_2": [
    {
      "type": 0,
      "value": "Ker se zasebni ključ uporablja za šifriranje datotek, ki jih shraniš v sefu, ga kasneje ni mogoče spremeniti."
    }
  ],
  "web.intro.step_4.content_3": [
    {
      "children": [
        {
          "type": 0,
          "value": "Če pozabiš svoj zasebni ključ, datotek ne boš mogel obnoviti."
        }
      ],
      "type": 8,
      "value": "b"
    },
    {
      "type": 0,
      "value": " Ključ se nikoli ne pošlje na strežnike Koofr in se tam tudi ne shrani."
    }
  ],
  "web.intro.step_4.title": [
    {
      "type": 0,
      "value": "Zasebni ključ"
    }
  ],
  "web.intro.step_5.content": [
    {
      "type": 0,
      "value": "Začni uporabljati Vault tako, da ustvariš svoj prvi sef."
    }
  ],
  "web.intro.step_5.title": [
    {
      "type": 0,
      "value": "Začni uporabljati Vault"
    }
  ],
