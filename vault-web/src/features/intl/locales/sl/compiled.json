  "web.landing_page.section_1.content": [
    {
      "type": 0,
      "value": "Koofr Vault je odprtokodna aplikacija za shranjevanje z ničelnim znanjem, ki deluje na strani odjemalca za "
    },
    {
      "children": [
        {
          "type": 0,
          "value": "oblačno shrambo Koofr"
        }
      ],
      "type": 8,
      "value": "a"
