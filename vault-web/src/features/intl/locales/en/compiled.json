  "web.landing_page.description": [
    {
      "type": 0,
      "value": "Powerful, open source, client-side, zero-knowledge encryption. Unlock enhanced security for your most sensitive files with Koofr Vault."
    }
  ],
  "web.landing_page.get_started.button": [
    {
      "type": 0,
      "value": "Get started"
    }
  ],
  "web.landing_page.section_1.content": [
    {
      "type": 0,
      "value": "Koofr Vault is an open source, client-side, zero-knowledge encrypted storage application by "
    },
    {
      "children": [
        {
          "type": 0,
          "value": "Koofr cloud storage"
        }
      ],
      "type": 8,
      "value": "a"
    },
    {
      "type": 0,
      "value": ". It's like having a box with a unique lock in your trunk: an extra layer of security to protect your files."
    }
  ],
  "web.landing_page.section_1.title": [
    {
      "type": 0,
      "value": "Extra strong protection"
    }
  ],
  "web.landing_page.section_10.description": [
    {
      "type": 0,
      "value": "Start encrypting your cloud storage files in just a few minutes. Included in all "
    },
    {
      "children": [
        {
          "type": 0,
          "value": "Koofr plans"
        }
      ],
      "type": 8,
      "value": "a"
    },
    {
      "type": 0,
      "value": "."
    }
  ],
  "web.landing_page.section_10.questions": [
    {
      "type": 0,
      "value": "Have questions about Koofr Vault? "
    },
    {
      "children": [
        {
          "type": 0,
          "value": "Find answers here"
        }
      ],
      "type": 8,
      "value": "a"
    },
    {
      "type": 0,
      "value": "."
    }
  ],
  "web.landing_page.section_10.title": [
    {
      "type": 0,
      "value": "Unlock your Vault"
    }
  ],
  "web.landing_page.section_2.content": [
    {
      "type": 0,
      "value": "Choose a Safe Key to create a Safe Box in your Koofr Vault."
    }
  ],
  "web.landing_page.section_2.title": [
    {
      "type": 0,
      "value": "Private Safe Key"
    }
  ],
  "web.landing_page.section_3.content": [
    {
      "type": 0,
      "value": "Your Safe Box files are encrypted or decrypted on demand, on your device."
    }
  ],
  "web.landing_page.section_3.title": [
    {
      "type": 0,
      "value": "It all stays in your browser"
    }
  ],
  "web.landing_page.section_4.content": [
    {
      "type": 0,
      "value": "Cloud content is encrypted and never accessible without your Safe Key."
    }
  ],
  "web.landing_page.section_4.title": [
    {
      "type": 0,
      "value": "Only you have access"
    }
  ],
  "web.landing_page.section_5.content_1": [
    {
      "type": 0,
      "value": "Your files are encrypted, file names and all content included, locally on your device with your Safe Key and some magic salt before they are sent to your Vault."
    }
  ],
  "web.landing_page.section_5.content_2": [
    {
      "type": 0,
      "value": "Neither your Safe key nor any other unencrypted file data or metadata is sent to or stored by "
    },
    {
      "children": [
        {
          "type": 0,
          "value": "Koofr"
        }
      ],
      "type": 8,
      "value": "a"
    },
    {
      "type": 0,
      "value": ". Only you can decrypt and access your Vault files."
    }
  ],
  "web.landing_page.section_5.title": [
    {
      "type": 0,
      "value": "For your eyes only"
    }
  ],
  "web.landing_page.section_6.content_1": [
    {
      "type": 0,
      "value": "Koofr Vault is "
    },
    {
      "children": [
        {
          "type": 0,
          "value": "open source"
        }
      ],
      "type": 8,
      "value": "a"
    },
    {
      "type": 0,
      "value": ", so you can always check that the code does exactly what is promised - and nothing more. File encryption is performed using NaCl SecretBox, which uses XSalsa20 cipher and Poly1305 for ensuring integrity."
    }
  ],
  "web.landing_page.section_6.content_2": [
    {
      "type": 0,
      "value": "It is compatible with "
    },
    {
      "children": [
        {
          "type": 0,
          "value": "rclone"
        }
      ],
      "type": 8,
      "value": "a"
    },
    {
      "type": 0,
      "value": " . This means that you can download your encrypted files and decrypt them locally using the rclone command-line tool."
    }
  ],
  "web.landing_page.section_6.title": [
    {
      "type": 0,
      "value": "Fully open source"
    }
  ],
  "web.landing_page.section_7.title": [
    {
      "type": 0,
      "value": "Client-side encryption"
    }
  ],
  "web.landing_page.section_8.title": [
    {
      "type": 0,
      "value": "Verifiable source code"
    }
  ],
  "web.landing_page.section_9.title": [
    {
      "type": 0,
      "value": "Zero knowledge"
    }
  ],
