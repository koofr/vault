  "web.intro.step_1.content": [
    {
      "type": 0,
      "value": "Welcome to Koofr Vault: your favourite cloud storage with client-side encryption!"
    }
  ],
  "web.intro.step_1.title": [
    {
      "type": 0,
      "value": "Welcome"
    }
  ],
  "web.intro.step_2.content_1": [
    {
      "type": 0,
      "value": "The Vault is like having a box with a unique lock in your trunk: an extra layer of security to protect your most sensitive files."
    }
  ],
  "web.intro.step_2.content_2": [
    {
      "type": 0,
      "value": "Vault is "
    },
    {
      "children": [
        {
          "type": 0,
          "value": "open source"
        }
      ],
      "type": 8,
      "value": "a"
    },
    {
      "type": 0,
      "value": ", so you can always check that the code does exactly what is promised - and nothing more."
    }
  ],
  "web.intro.step_2.content_3": [
    {
      "children": [
        {
          "type": 0,
          "value": "rclone"
        }
      ],
      "type": 8,
      "value": "a"
    },
    {
      "type": 0,
      "value": " compatibility: Download your encrypted files and decrypt them locally using the rclone command-line tool."
    }
  ],
  "web.intro.step_2.title": [
    {
      "type": 0,
      "value": "About Vault"
    }
  ],
  "web.intro.step_3.content_1": [
    {
      "type": 0,
      "value": "You can have one or more Safe Boxes in your Vault, with separate Safe Keys for each Safe Box."
    }
  ],
  "web.intro.step_3.content_2": [
    {
      "type": 0,
      "value": "Vault encrypts both file names and content, so they are only readable inside the Safe Box."
    }
  ],
  "web.intro.step_3.content_3": [
    {
      "type": 0,
      "value": "In your main Koofr app, the files will appear with encrypted file names and cannot be opened."
    }
  ],
  "web.intro.step_3.title": [
    {
      "type": 0,
      "value": "Safe Boxes"
    }
  ],
  "web.intro.step_4.content_1": [
    {
      "type": 0,
      "value": "When you create a Safe Box, you'll choose a Safe Key for it."
    }
  ],
  "web.intro.step_4.content_2": [
    {
      "type": 0,
      "value": "Since the Safe Key is used to encrypt the files you store in the Safe Box, it cannot be changed later."
    }
  ],
  "web.intro.step_4.content_3": [
    {
      "children": [
        {
          "type": 0,
          "value": "There is no way recover your files if you forget your Safe Key."
        }
      ],
      "type": 8,
      "value": "b"
    },
    {
      "type": 0,
      "value": " It is never sent to or stored on Koofr servers."
    }
  ],
  "web.intro.step_4.title": [
    {
      "type": 0,
      "value": "Safe Key"
    }
  ],
  "web.intro.step_5.content": [
    {
      "type": 0,
      "value": "Get started with Vault by creating your first Safe Box."
    }
  ],
  "web.intro.step_5.title": [
    {
      "type": 0,
      "value": "Start using Vault"
    }
  ],
