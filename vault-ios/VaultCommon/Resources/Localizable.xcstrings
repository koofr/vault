    },
    "ios.repo_create.form.password.info.button.a11y.label" : {
      "comment" : "Accessibility label for the safe key help button in create Safe Box form.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Safe Key info"
          }
        }
      }
    },
    "ios.repo_create.form.password.info.text" : {
      "comment" : "Detailed help text in create Safe Box flow explaining the Safe Key field and recovery limitations.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Safe Key is a password used to encrypt your files. Each Safe Box can have its own unique Safe Key.\n\nPlease be aware that once you set your Safe Key, it cannot be changed later. All the files within the Safe Box will be encrypted using this key.\n\nIMPORTANT: Your Safe Key cannot be reset, and there is no way to recover your files if you forget it, as it is never sent to or stored on Koofr servers."
          }
        }
      }
    },
    "ios.repo_create.form.password.info.title" : {
      "comment" : "Title of the safe key help sheet in create Safe Box form.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Safe Key"
          }
        }
      }
    },
    "ios.repo_create.form.password.label" : {
      "comment" : "Section header label for safe key input in create Safe Box form.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Safe Key"
          }
        }
      }
    },
    "ios.repo_create.form.password.placeholder" : {
      "comment" : "Placeholder for the Safe Key field describing minimum length requirement.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Must be at least 8 characters long"
          }
        }
      }
    },
    "ios.repo_create.form.salt.a11y.label" : {
      "comment" : "Accessibility label for the salt input field in create Safe Box form.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
