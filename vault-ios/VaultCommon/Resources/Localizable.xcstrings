    },
    "ios.repo_create.form.location.info.text" : {
      "comment" : "Detailed help text in create Safe Box flow explaining the Location field.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Location refers to a folder within your Koofr where all of your Safe Box files and folders are securely stored.\n\nIf this is your first Safe Box, the default location will be \"My safe box.\" You can change it if you prefer.\n\nIf you already have a Safe Box or wish to use an existing folder (e.g. one created with rclone), you can select that folder.\n\nPlease note that you can only select a folder located within your Koofr."
          }
        }
      }
    },
    "ios.repo_create.form.location.info.title" : {
      "comment" : "Title of the location help sheet in create Safe Box form.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Location"
          }
        }
      }
    },
    "ios.repo_create.form.location.label" : {
