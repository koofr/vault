      }
    },
    "ios.repo_create.form.salt.info.button.a11y.label" : {
      "comment" : "Accessibility label for the salt help button in create Safe Box form.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Salt info"
          }
        }
      }
    },
    "ios.repo_create.form.salt.info.text" : {
      "comment" : "Detailed help text in create Safe Box flow explaining the Salt field.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Salt is used in the key derivation process to create a unique encryption key and helps to protect against potential attacks. It will be stored on the Koofr servers in a secure manner.\n\nA random Salt has been generated for you. If you prefer, you can leave the Salt field empty, and the default salt will be used (same as in rclone). However, it is recommended to use a unique salt for enhanced security. Using a unique salt helps to increase the complexity of the encryption process, making it more difficult for potential attackers to access the encrypted data.\n\nIf you wish to transfer the encrypted files to another service, it is necessary to also export the salt, otherwise you won't be able to decrypt your files."
          }
        }
      }
    },
    "ios.repo_create.form.salt.info.title" : {
      "comment" : "Title of the salt help sheet in create Safe Box form.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Salt"
          }
        }
      }
    },
