    <string name="repo_create_form_location_info_button_content_desc">Location info</string>
    <!-- Help sheet body text explaining the location field in Safe Box creation. -->
    <string name="repo_create_form_location_info_text">Location refers to a folder within your Koofr where all of your Safe Box files and folders are securely stored.\n\nIf this is your first Safe Box, the default location will be \"My safe box.\" You can change it if you prefer.\n\nIf you already have a Safe Box or wish to use an existing folder (e.g. one created with rclone), you can select that folder.\n\nPlease note that you can only select a folder located within your Koofr.</string>
    <!-- Title for the location help sheet in Safe Box creation. -->
    <string name="repo_create_form_location_info_title">Location</string>
    <!-- Label for the location field in Safe Box creation form. -->
    <string name="repo_create_form_location_label">Location</string>
    <!-- Accessibility label for the Safe Key help icon in Safe Box creation form. -->
    <string name="repo_create_form_password_info_button_content_desc">Safe Key info</string>
    <!-- Help sheet body text explaining the Safe Key in Safe Box creation. -->
    <string name="repo_create_form_password_info_text">Safe Key is a password used to encrypt your files. Each Safe Box can have its own unique Safe Key.\n\nPlease be aware that once you set your Safe Key, it cannot be changed later. All the files within the Safe Box will be encrypted using this key.\n\nIMPORTANT: Your Safe Key cannot be reset, and there is no way to recover your files if you forget it, as it is never sent to or stored on Koofr servers.</string>
    <!-- Title for the Safe Key help sheet in Safe Box creation. -->
    <string name="repo_create_form_password_info_title">Safe Key</string>
    <!-- Placeholder text for the Safe Key field in Safe Box creation form. -->
    <string name="repo_create_form_password_placeholder">Must be at least 8 characters long</string>
    <!-- Accessibility label for the Salt field in Safe Box creation form. -->
    <string name="repo_create_form_salt_content_desc">Salt</string>
    <!-- Accessibility label for the Salt help icon in Safe Box creation form. -->
    <string name="repo_create_form_salt_info_button_content_desc">Salt info</string>
    <!-- Help sheet body text explaining the Salt field in Safe Box creation. -->
    <string name="repo_create_form_salt_info_text">Salt is used in the key derivation process to create a unique encryption key and helps to protect against potential attacks. It will be stored on the Koofr servers in a secure manner.  A random Salt has been generated for you. If you prefer, you can leave the Salt field empty, and the default salt will be used (same as in rclone). However, it is recommended to use a unique salt for enhanced security. Using a unique salt helps to increase the complexity of the encryption process, making it more difficult for potential attackers to access the encrypted data.  If you wish to transfer the encrypted files to another service, it is necessary to also export the salt, otherwise you won\'t be able to decrypt your files.</string>
    <!-- Title for the Salt help sheet in Safe Box creation. -->
    <string name="repo_create_form_salt_info_title">Salt</string>
    <!-- Label for the Salt field in Safe Box creation form. -->
